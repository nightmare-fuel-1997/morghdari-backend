# =============================================================================
# .env.vps.example — copy to `.env` ON THE VPS and fill every value.
# NEVER commit `.env` to git (it holds production secrets).
#
# Generate secrets with:  openssl rand -hex 32
# =============================================================================

# --- Local build tag (images are built on the VPS, not pulled) ---
MORGHDARI_TAG=vps-01

# --- Django ---
# REQUIRED in production — the app refuses to boot without it.
DJANGO_SECRET_KEY=change-me-64-hex-chars-min
# Comma-separated hosts nginx serves. Empty => the app raises at boot.
# Example: DJANGO_ALLOWED_HOSTS=api.morghdari.com,daphne
# BUG-21: keep `daphne` in the list - Prometheus scrapes daphne:8000.
DJANGO_ALLOWED_HOSTS=
DJANGO_DEBUG=False

# --- Postgres (application + admin roles) ---
DATABASE_NAME=morghdari
DATABASE_USER=morghdari_app
DATABASE_PASSWORD=change-me
POSTGRES_ADMIN_USER=morghdari_admin
POSTGRES_ADMIN_PASSWORD=change-me
# Password for the read-only exporter role (set by scripts/prod_bootstrap.sh).
POSTGRES_EXPORTER_PASSWORD=change-me

# --- Redis ---
REDIS_PASSWORD=change-me

# --- EMQX (broker dashboard + Postgres auth chain) ---
EMQX_DASHBOARD_PASSWORD=change-me
EMQX_NODE__COOKIE=change-me-erlang-cookie
EMQX_DB_USER=emqx_auth
EMQX_DB_PASSWORD=change-me

# --- MQTT subscribers (service accounts seeded by prod_bootstrap.sh) ---
SUBSCRIBER_USERNAME=subscriber-01
SUBSCRIBER_PASSWORD=change-me
SUBSCRIBER_USERNAME_2=subscriber-02
SUBSCRIBER_PASSWORD_2=change-me

# --- WAL archiving / backups (M8-01) ---
# NOT an AWS requirement. These are the standard S3 credential variable names
# that wal-g (inside the postgres image) reads: WALG_S3_PREFIX + AWS_*. Only the
# `postgres` service consumes them - daphne, celery, both subscribers, nginx,
# EMQX and Redis never see them.
# Any S3-compatible store works (Cloudflare R2, Backblaze B2, Wasabi,
# self-hosted MinIO): put that provider's keys in AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, set AWS_ENDPOINT to its endpoint URL and
# AWS_S3_FORCE_PATH_STYLE=true (false for real AWS S3).
# Leave EMPTY only for a short API test: the stack still boots, but wal-g
# archiving fails and pg_wal grows without bound (README_VPS.md A7) - and no
# alert covers it (monitoring/alerts.yml has no WAL/backup rule).
# Dropping backups entirely is a DR decision, not a variable: archive_mode=on
# and archive_command=wal-g are baked into docker/postgres-walg.
WALG_S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# --- TLS certificate hostnames + contact (read by scripts/tls_issue_vps.sh) ---
# The script now reads these from THIS file, so `sudo bash scripts/tls_issue_vps.sh`
# works as documented: sudo resets the environment, so an exported shell variable
# would never reach it (that was the 2026-09-16 VPS-day-1 blocker).
PRIMARY_DOMAIN=api.morghdari.com
MQTT_DOMAIN=mqtt.morghdari.com
# Leave MQTT_DOMAIN empty to issue a single-name certificate - useful before the
# mqtt.<domain> A record exists. Set it and re-run once the record is live.
# CERTIFICATE_EMAIL must be a mailbox you read, NOT a hostname: it is the
# certificate expiry contact.
CERTIFICATE_EMAIL=

# --- Build-time package index (optional) ---
# Some hosts cannot reach pypi.org at all (VPS 185.8.175.150: 45 s to first
# byte, then timeouts - the app image build fails with "No matching
# distribution found for Django"). Set a reachable index here and the backend
# image builds from it; leave empty to use the default PyPI index:
#   PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple/
# NOTE: a third-party mirror serves the packages - use one you trust.
PIP_INDEX_URL=
