# =============================================================================
# .env.example — copy to `.env` and override what you need (M0-10).
#
# فارسی: این فایل «فهرست کامل متغیرهای محیطی» پروژه است؛ هر متغیری که
# settings می‌خواند باید اینجا باشد — اگر کم بود، این فایل ناقص است.
#
# Acceptance rule (TASKS M0-10): EVERY env var read by
# backend/config/settings/{base,test,development,production}.py appears here.
# Currently that is exactly the four below — no others may be introduced
# without landing in this file in the same commit.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Single-env connection convention (Blueprint §2): one URL carries host, port,
# name, user AND password. The discrete PGHOST/PGNAME style is banned.
# Default below mirrors docker-compose.dev.yml exactly (dev-only credentials).
# PRODUCTION MUST SET THIS EXPLICITLY to the morghdari_app role URL — the dev
# fallback in base.py points at localhost and must never reach a real deploy.
DATABASE_URL=postgres://morghdari_dev:dev_password_only@localhost:5432/morghdari_dev

# --- Redis ------------------------------------------------------------------
# Same single-URL convention. Password travels INSIDE the URL. Settings split
# the one server into logical DBs: broker=/0, cache=/1, channels=/2.
REDIS_URL=redis://:dev_redis_password@localhost:6379

# --- Django core ------------------------------------------------------------
# Dev/test use built-in insecure defaults; production.py reads this with
# os.environ[...] and REFUSES TO BOOT without it (fail-loud by design).
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me

# Comma-separated hosts production will serve; empty/missing => RuntimeError
# at boot. Example: DJANGO_ALLOWED_HOSTS=api.morghdari.example,morghdari.example
DJANGO_ALLOWED_HOSTS=
